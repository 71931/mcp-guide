{
  "mcpServers": {
    "luckin-coffee": {
      "type": "streamablehttp",
      "url": "https://gwmcp.lkcoffee.com/order/user/mcp",
      "headers": {
        "Authorization": "Bearer 你的瑞幸Token"
      }
    },
    "mcd-china": {
      "type": "streamablehttp",
      "url": "https://mcp.mcd.cn",
      "headers": {
        "Authorization": "Bearer 你的麦当劳MCP_Token"
      }
    },
    "amap-maps": {
      "type": "streamablehttp",
      "url": "https://mcp.amap.com/mcp?key=你的高德Key"
    },
    "amap-maps-local": {
      "command": "npx",
      "args": ["-y", "@amap/amap-maps-mcp-server"],
      "env": {
        "AMAP_MAPS_API_KEY": "你的高德Key"
      }
    }
  }
}
